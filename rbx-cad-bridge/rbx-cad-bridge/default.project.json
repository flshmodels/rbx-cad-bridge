{
  "name": "rbx-cad-bridge",
  "tree": {
    "$className": "DataModel",
    "HttpService": {
      "$className": "HttpService",
      "$properties": { "HttpEnabled": true }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "CadBridgeShared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "CadBridgeServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "CadBridgeClient": { "$path": "src/client" }
      }
    }
  }
}
