--!strict
local T = require("./framework")
local Backoff = require("../src/server/Core/Backoff")
local RateLimiter = require("../src/server/Core/RateLimiter")
local KeyedLimiter = require("../src/server/Core/KeyedLimiter")
local Diff = require("../src/server/Core/Diff")
local Geo = require("../src/server/Core/Geo")
local CommandParser = require("../src/shared/CommandParser")
local Helpers = require("./helpers")

T.describe("Backoff", function()
	T.test("grows exponentially and is capped", function()
		local high = function()
			return 1
		end
		T.near(Backoff.delay(1, 1, 30, high), 1)
		T.near(Backoff.delay(2, 1, 30, high), 2)
		T.near(Backoff.delay(3, 1, 30, high), 4)
		T.near(Backoff.delay(10, 1, 30, high), 30)
	end)
	T.test("never returns less than half the ceiling (no instant retries)", function()
		local low = function()
			return 0
		end
		T.near(Backoff.delay(3, 1, 30, low), 2)
	end)
end)

T.describe("RateLimiter", function()
	T.test("allows a burst up to capacity, then refuses", function()
		local clock = Helpers.manualClock()
		local limiter = RateLimiter.new(3, 1, clock.read)
		T.truthy(limiter:tryAcquire())
		T.truthy(limiter:tryAcquire())
		T.truthy(limiter:tryAcquire())
		T.eq(limiter:tryAcquire(), false)
	end)
	T.test("refills over time but never beyond capacity", function()
		local clock = Helpers.manualClock()
		local limiter = RateLimiter.new(2, 1, clock.read)
		limiter:tryAcquire()
		limiter:tryAcquire()
		clock.now += 1
		T.truthy(limiter:tryAcquire())
		T.eq(limiter:tryAcquire(), false)
		clock.now += 1000
		T.truthy(limiter:tryAcquire(2))
		T.eq(limiter:tryAcquire(), false)
	end)
	T.test("timeUntil reports the wait", function()
		local clock = Helpers.manualClock()
		local limiter = RateLimiter.new(1, 2, clock.read)
		limiter:tryAcquire()
		T.near(limiter:timeUntil(), 0.5)
		clock.now += 0.5
		T.near(limiter:timeUntil(), 0)
	end)
end)

T.describe("KeyedLimiter", function()
	T.test("limits each key independently and forgets removed keys", function()
		local clock = Helpers.manualClock()
		local keyed = KeyedLimiter.new(function()
			return RateLimiter.new(1, 0.01, clock.read)
		end)
		T.truthy(keyed:allow(1))
		T.eq(keyed:allow(1), false)
		T.truthy(keyed:allow(2))
		keyed:remove(1)
		T.truthy(keyed:allow(1))
	end)
end)

T.describe("Diff", function()
	T.test("detects added, changed and removed records", function()
		local result = Diff.compute(
			{ a = { n = 1 }, b = { n = 2 }, c = { n = 3 } },
			{ a = { n = 1 }, b = { n = 9 }, d = { n = 4 } }
		)
		T.deepEq(result.added, { d = { n = 4 } })
		T.deepEq(result.changed, { b = { old = { n = 2 }, new = { n = 9 } } })
		T.deepEq(result.removed, { c = { n = 3 } })
	end)
	T.test("treats nested equal tables as unchanged", function()
		local result = Diff.compute({ a = { x = { 1, 2 } } }, { a = { x = { 1, 2 } } })
		T.truthy(Diff.isEmpty(result))
	end)
	T.test("handles nil snapshots (Firebase returns null for empty paths)", function()
		T.truthy(Diff.isEmpty(Diff.compute(nil, nil)))
		T.deepEq(Diff.compute(nil, { a = 1 }).added, { a = 1 })
	end)
end)

T.describe("Geo", function()
	local zones =
		{ { name = "Courthouse", x = 0, z = 0 }, { name = "Gas Station", x = 100, z = 0 } }
	T.test("finds the nearest zone on the horizontal plane", function()
		local zone, dist = Geo.nearest(90, 0, zones)
		T.eq((zone :: any).name, "Gas Station")
		T.near(dist :: number, 10)
	end)
	T.test("describes near and far positions differently", function()
		T.eq(Geo.describe(5, 0, zones, 25), "Courthouse [5, 0]")
		T.eq(Geo.describe(50, 0, zones, 25), "Near Courthouse, ~50 studs [50, 0]")
		T.eq(Geo.describe(1, 1, {}, 25), "Unknown [1, 1]")
	end)
end)

T.describe("CommandParser", function()
	T.test("parses nature and details", function()
		local input = CommandParser.parseCall("/911 Shots fired | man with a handgun")
		T.deepEq(input, { nature = "Shots fired", description = "man with a handgun" })
	end)
	T.test("parses a priority tag", function()
		local input = CommandParser.parseCall("/911 !HIGH Pursuit | red sedan")
		T.deepEq(input, { nature = "Pursuit", description = "red sedan", priority = "high" })
	end)
	T.test("allows a call with no details", function()
		local input = CommandParser.parseCall("/911 Officer down")
		T.deepEq(input, { nature = "Officer down", description = "" })
	end)
	T.test("rejects empty and unknown priority", function()
		local a, errA = CommandParser.parseCall("/911")
		T.eq(a, nil)
		T.eq(errA, CommandParser.USAGE)
		local b, errB = CommandParser.parseCall("/911 !urgent Help")
		T.eq(b, nil)
		T.eq(errB, CommandParser.USAGE)
	end)
end)
